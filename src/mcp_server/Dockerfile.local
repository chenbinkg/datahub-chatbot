# Simplified Dockerfile for local testing
FROM python:3.11.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20 for MongoDB MCP server
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

# Set working directory
WORKDIR /app

# Install Python dependencies
RUN pip install fastapi uvicorn pymongo requests boto3

# Install official MongoDB MCP server globally
RUN npm install -g mongodb-mcp-server@latest

# Copy application code
COPY . .

# Expose ports
EXPOSE 8000 8001

# Create startup script with official MongoDB MCP server
RUN echo '#!/bin/bash\n\
echo "=== Starting services ==="\n\
echo "Starting official MongoDB MCP server on port 8001..."\n\
# Start MongoDB MCP server as HTTP server\n\
# Get MongoDB connection string from SSM parameter or environment\n\
MONGO_URI=${MONGO_URI:-"mongodb://localhost:27017"}\n\
echo "Using MongoDB URI: $MONGO_URI"\n\
# Start MongoDB MCP server with HTTP transport using correct parameter format\n\
MDB_MCP_CONNECTION_STRING="$MONGO_URI" \\\n\
MDB_MCP_READ_ONLY="true" \\\n\
mongodb-mcp-server --transport http --httpHost 0.0.0.0 --httpPort 8001 &\n\
MONGODB_PID=$!\n\
echo "MongoDB MCP server started with PID: $MONGODB_PID on port 8001"\n\
# Wait a moment for the server to start\n\
sleep 3\n\
echo "Starting main MCP server on port 8000..."\n\
cd /app\n\
python -m uvicorn main:app --host 0.0.0.0 --port 8000\n\
' > /app/start.sh && chmod +x /app/start.sh

CMD ["/app/start.sh"]